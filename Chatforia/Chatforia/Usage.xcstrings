    "AI tools share one action allowance. Translation counts processed characters. Voice-note transcription and live captions share recorded usage; voicemail is separate. A zero limit means no included allowance. Feature eligibility still depends on your plan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI tools share one action allowance. Translation counts processed characters. Voice-note transcription and live captions share recorded usage; voicemail is separate. A zero limit means no included allowance. Feature eligibility still depends on your plan."
          }
        }
      }
    },
    "App calls count each connected person's time against the caller's allowance. Two people calling for one minute use two participant-minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App calls count each connected person's time against the caller's allowance. Two people calling for one minute use two participant-minutes."
          }
        }
      }
    },
    "Reaching a limit pauses that feature until reset. It does not stop ordinary in-app text chat. Usage updates after processing; refresh for the latest balance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching a limit pauses that feature until reset. It does not stop ordinary in-app text chat. Usage updates after processing; refresh for the latest balance."
          }
        }
      }
    },
